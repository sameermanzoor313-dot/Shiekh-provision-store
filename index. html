<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sheikh Provision Store - Online Grocery & Kiryana</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 font-sans text-slate-800">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect } = React;

    const DEFAULT_PRODUCTS = [
      { id: 1, name: "Aashirvaad Shuddh Chakki Atta", category: "Atta & Flours", price: 340, unit: "10 kg", image: "https://images.unsplash.com/photo-1574323347407-f5e1ad6d020b?auto=format&fit=crop&q=80&w=400", inStock: true },
      { id: 2, name: "Basmati Rice (Premium)", category: "Rice & Pulses", price: 120, unit: "1 kg", image: "https://images.unsplash.com/photo-1586201375761-83865001e31c?auto=format&fit=crop&q=80&w=400", inStock: true },
      { id: 3, name: "Fortune Mustard Oil", category: "Edible Oils", price: 165, unit: "1 L", image: "https://images.unsplash.com/photo-1474979266404-7eaacbcd87c5?auto=format&fit=crop&q=80&w=400", inStock: true },
      { id: 4, name: "Tata Salt Vacuum Evaporated", category: "Spices & Salt", price: 28, unit: "1 kg", image: "https://images.unsplash.com/photo-1518110168401-f2877ee2c08c?auto=format&fit=crop&q=80&w=400", inStock: true },
      { id: 5, name: "Toor Dal (Arhar)", category: "Rice & Pulses", price: 160, unit: "1 kg", image: "https://images.unsplash.com/photo-1585996877048-7096d21f8a8e?auto=format&fit=crop&q=80&w=400", inStock: true },
      { id: 6, name: "Tata Tea Gold", category: "Tea & Beverages", price: 240, unit: "500 g", image: "https://images.unsplash.com/photo-1576092768241-dec231879fc3?auto=format&fit=crop&q=80&w=400", inStock: true }
    ];

    function App() {
      const [view, setView] = useState('customer');
      const [products, setProducts] = useState(() => {
        const saved = localStorage.getItem('sheikh_products');
        return saved ? JSON.parse(saved) : DEFAULT_PRODUCTS;
      });
      const [cart, setCart] = useState([]);
      const [search, setSearch] = useState('');
      const [selectedCategory, setSelectedCategory] = useState('All');
      const [adminPin, setAdminPin] = useState('');
      const [isAdminAuthenticated, setIsAdminAuthenticated] = useState(false);
      const [orders, setOrders] = useState(() => {
        const saved = localStorage.getItem('sheikh_orders');
        return saved ? JSON.parse(saved) : [];
      });

      const [storeInfo, setStoreInfo] = useState({
        name: "Sheikh Provision Store",
        phone: "8082433742",
        upi: "8082433742@upi",
        address: "Hapatnard, Anantnag, J&K"
      });

      const [newProduct, setNewProduct] = useState({
        name: '', category: 'Atta & Flours', price: '', unit: '', image: '', inStock: true
      });

      const [customerDetails, setCustomerDetails] = useState({ name: '', phone: '', address: '', paymentMethod: 'cod' });

      useEffect(() => {
        localStorage.setItem('sheikh_products', JSON.stringify(products));
      }, [products]);

      useEffect(() => {
        localStorage.setItem('sheikh_orders', JSON.stringify(orders));
      }, [orders]);

      const categories = ['All', ...new Set(products.map(p => p.category))];

      const filteredProducts = products.filter(p => {
        const matchesSearch = p.name.toLowerCase().includes(search.toLowerCase());
        const matchesCategory = selectedCategory === 'All' || p.category === selectedCategory;
        return matchesSearch && matchesCategory;
      });

      const addToCart = (product) => {
        setCart(prev => {
          const existing = prev.find(item => item.id === product.id);
          if (existing) {
            return prev.map(item => item.id === product.id ? { ...item, qty: item.qty + 1 } : item);
          }
          return [...prev, { ...product, qty: 1 }];
        });
      };

      const updateQty = (id, delta) => {
        setCart(prev => prev.map(item => {
          if (item.id === id) {
            const newQty = item.qty + delta;
            return newQty > 0 ? { ...item, qty: newQty } : null;
          }
          return item;
        }).filter(Boolean));
      };

      const totalAmount = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

      const placeOrder = () => {
        if (!customerDetails.name || !customerDetails.phone || !customerDetails.address) {
          alert("Lutfan saari details (Naam, Mobile, Address) bharein!");
          return;
        }

        const newOrder = {
          id: 'ORD' + Date.now().toString().slice(-6),
          date: new Date().toLocaleString(),
          customer: customerDetails,
          items: cart,
          total: totalAmount,
          status: 'Pending'
        };

        setOrders([newOrder, ...orders]);

        let text = `*NEW ORDER - ${storeInfo.name}*\n`;
        text += `*Order ID:* ${newOrder.id}\n`;
        text += `*Customer:* ${customerDetails.name} (${customerDetails.phone})\n`;
        text += `*Address:* ${customerDetails.address}\n`;
        text += `*Payment:* ${customerDetails.paymentMethod.toUpperCase()}\n\n`;
        text += `*Items:*\n`;
        cart.forEach((item, index) => {
          text += `${index + 1}. ${item.name} (${item.unit}) x ${item.qty} = ₹${item.price * item.qty}\n`;
        });
        text += `\n*Total Amount:* ₹${totalAmount}`;

        const waUrl = `https://wa.me/91${storeInfo.phone}?text=${encodeURIComponent(text)}`;
        setCart([]);
        window.open(waUrl, '_blank');
      };

      const handleAddProduct = (e) => {
        e.preventDefault();
        if (!newProduct.name || !newProduct.price) return;
        const item = {
          ...newProduct,
          id: Date.now(),
          price: Number(newProduct.price),
          image: newProduct.image || "https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&q=80&w=400"
        };
        setProducts([item, ...products]);
        setNewProduct({ name: '', category: 'Atta & Flours', price: '', unit: '', image: '', inStock: true });
      };

      const toggleStock = (id) => {
        setProducts(products.map(p => p.id === id ? { ...p, inStock: !p.inStock } : p));
      };

      const deleteProduct = (id) => {
        if (confirm("Kya aap is item ko delete karna chahte hain?")) {
          setProducts(products.filter(p => p.id !== id));
        }
      };

      return (
        <div class="min-h-screen pb-12">
          {/* Header */}
          <header class="bg-emerald-700 text-white shadow-lg sticky top-0 z-50">
            <div class="max-w-5xl mx-auto px-4 py-3 flex justify-between items-center">
              <div>
                <h1 class="text-xl font-bold flex items-center gap-2">
                  <i class="fa-solid fa-store text-emerald-300"></i> {storeInfo.name}
                </h1>
                <p class="text-xs text-emerald-200"><i class="fa-solid fa-location-dot"></i> {storeInfo.address} | Ph: {storeInfo.phone}</p>
              </div>
              <div class="flex gap-2">
                <button 
                  onClick={() => setView('customer')}
                  class={`px-3 py-1.5 rounded-lg text-sm font-medium transition ${view === 'customer' ? 'bg-white text-emerald-800' : 'bg-emerald-800 text-white'}`}
                >
                  <i class="fa-solid fa-shopping-basket"></i> Store
                </button>
                <button 
                  onClick={() => setView('admin')}
                  class={`px-3 py-1.5 rounded-lg text-sm font-medium transition ${view === 'admin' ? 'bg-white text-emerald-800' : 'bg-emerald-800 text-white'}`}
                >
                  <i class="fa-solid fa-user-gear"></i> Admin
                </button>
              </div>
            </div>
          </header>

          {/* Customer Store View */}
          {view === 'customer' && (
            <main class="max-w-5xl mx-auto px-4 py-6">
              {/* Search & Categories */}
              <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 space-y-3">
                <div class="relative">
                  <i class="fa-solid fa-magnifying-glass absolute left-3 top-3.5 text-slate-400"></i>
                  <input 
                    type="text" 
                    placeholder="Search items (Atta, Rice, Oil, Tea...)" 
                    value={search}
                    onChange={(e) => setSearch(e.target.value)}
                    class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                  />
                </div>
                <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-none">
                  {categories.map(cat => (
                    <button
                      key={cat}
                      onClick={() => setSelectedCategory(cat)}
                      class={`px-3 py-1 rounded-full text-xs whitespace-nowrap border ${selectedCategory === cat ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-slate-100 text-slate-600 border-slate-200'}`}
                    >
                      {cat}
                    </button>
                  ))}
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {/* Product List */}
                <div class="md:col-span-2 grid grid-cols-2 sm:grid-cols-3 gap-4">
                  {filteredProducts.map(p => (
                    <div key={p.id} class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between">
                      <img src={p.image} alt={p.name} class="h-32 w-full object-cover" />
                      <div class="p-3 flex-1 flex flex-col justify-between">
                        <div>
                          <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">{p.category}</span>
                          <h3 class="font-medium text-slate-800 text-sm mt-1 line-clamp-2">{p.name}</h3>
                          <p class="text-xs text-slate-500">{p.unit}</p>
                        </div>
                        <div class="mt-3 flex items-center justify-between">
                          <span class="font-bold text-slate-900">₹{p.price}</span>
                          {p.inStock ? (
                            <button 
                              onClick={() => addToCart(p)}
                              class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-2.5 py-1.5 rounded-lg font-medium"
                            >
                              + Add
                            </button>
                          ) : (
                            <span class="text-[10px] text-red-500 font-bold">Out of Stock</span>
                          )}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

                {/* Cart & Checkout */}
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 h-fit sticky top-20">
                  <h2 class="font-bold text-lg border-b pb-2 flex items-center justify-between">
                    <span><i class="fa-solid fa-cart-shopping text-emerald-600"></i> Your Cart</span>
                    <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">{cart.length} items</span>
                  </h2>

                  {cart.length === 0 ? (
                    <p class="text-slate-400 text-sm py-8 text-center">Cart is empty. Add items to order!</p>
                  ) : (
                    <div class="space-y-4 mt-3">
                      <div class="max-h-56 overflow-y-auto divide-y">
                        {cart.map(item => (
                          <div key={item.id} class="py-2 flex items-center justify-between text-sm">
                            <div class="flex-1">
                              <p class="font-medium text-slate-800">{item.name}</p>
                              <p class="text-xs text-slate-500">₹{item.price} x {item.qty}</p>
                            </div>
                            <div class="flex items-center gap-2">
                              <button onClick={() => updateQty(item.id, -1)} class="w-6 h-6 bg-slate-100 rounded text-slate-600 font-bold">-</button>
                              <span class="text-xs font-semibold">{item.qty}</span>
                              <button onClick={() => updateQty(item.id, 1)} class="w-6 h-6 bg-slate-100 rounded text-slate-600 font-bold">+</button>
                            </div>
                          </div>
                        ))}
                      </div>

                      <div class="border-t pt-3 flex justify-between font-bold text-slate-900">
                        <span>Total Amount:</span>
                        <span>₹{totalAmount}</span>
                      </div>

                      {/* Checkout Details */}
                      <div class="space-y-2 border-t pt-3">
                        <input 
                          type="text" 
                          placeholder="Your Name *" 
                          value={customerDetails.name}
                          onChange={e => setCustomerDetails({...customerDetails, name: e.target.value})}
                          class="w-full text-xs p-2 border rounded"
                        />
                        <input 
                          type="text" 
                          placeholder="Phone / Mobile *" 
                          value={customerDetails.phone}
                          onChange={e => setCustomerDetails({...customerDetails, phone: e.target.value})}
                          class="w-full text-xs p-2 border rounded"
                        />
                        <textarea 
                          placeholder="Delivery Address *" 
                          value={customerDetails.address}
                          onChange={e => setCustomerDetails({...customerDetails, address: e.target.value})}
                          class="w-full text-xs p-2 border rounded h-16"
                        ></textarea>

                        <div class="space-y-1">
                          <label class="text-xs font-semibold text-slate-600">Payment Option:</label>
                          <select 
                            value={customerDetails.paymentMethod}
                            onChange={e => setCustomerDetails({...customerDetails, paymentMethod: e.target.value})}
                            class="w-full text-xs p-2 border rounded bg-slate-50"
                          >
                            <option value="cod">Cash on Delivery (COD)</option>
                            <option value="upi">UPI / GPay / PhonePe ({storeInfo.upi})</option>
                          </select>
                        </div>

                        {customerDetails.paymentMethod === 'upi' && (
                          <div class="bg-slate-50 p-3 rounded text-center border">
                            <p class="text-[11px] text-slate-600 mb-1">Scan & Pay via UPI:</p>
                            <img 
                              src={`https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=upi://pay?pa=${storeInfo.upi}&pn=${encodeURIComponent(storeInfo.name)}&am=${totalAmount}&cu=INR`} 
                              alt="UPI QR Code" 
                              class="mx-auto w-28 h-28 border bg-white p-1 rounded"
                            />
                            <p class="text-[10px] text-slate-500 mt-1">UPI ID: {storeInfo.upi}</p>
                          </div>
                        )}

                        <button 
                          onClick={placeOrder}
                          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-lg text-sm flex items-center justify-center gap-2 shadow-md"
                        >
                          <i class="fa-brands fa-whatsapp text-lg"></i> Send Order on WhatsApp
                        </button>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </main>
          )}

          {/* Admin Dashboard */}
          {view === 'admin' && (
            <main class="max-w-4xl mx-auto px-4 py-6">
              {!isAdminAuthenticated ? (
                <div class="max-w-sm mx-auto bg-white p-6 rounded-xl shadow-md border text-center space-y-4 mt-12">
                  <i class="fa-solid fa-lock text-3xl text-emerald-600"></i>
                  <h2 class="font-bold text-lg">Admin Login</h2>
                  <input 
                    type="password" 
                    placeholder="Enter PIN (Default: 1234)" 
                    value={adminPin}
                    onChange={e => setAdminPin(e.target.value)}
                    class="w-full p-2 border rounded text-center text-lg tracking-widest"
                  />
                  <button 
                    onClick={() => adminPin === '1234' ? setIsAdminAuthenticated(true) : alert("Wrong PIN! Try 1234")}
                    class="w-full bg-emerald-600 text-white font-bold py-2 rounded"
                  >
                    Login
                  </button>
                </div>
              ) : (
                <div class="space-y-6">
                  {/* Add Product Form */}
                  <div class="bg-white p-4 rounded-xl shadow-sm border space-y-3">
                    <h2 class="font-bold text-slate-800 flex items-center gap-2"><i class="fa-solid fa-plus-circle text-emerald-600"></i> Add New Product</h2>
                    <form onSubmit={handleAddProduct} class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <input 
                        type="text" placeholder="Product Name" value={newProduct.name}
                        onChange={e => setNewProduct({...newProduct, name: e.target.value})}
                        class="p-2 border rounded text-xs" required 
                      />
                      <select 
                        value={newProduct.category}
                        onChange={e => setNewProduct({...newProduct, category: e.target.value})}
                        class="p-2 border rounded text-xs"
                      >
                        <option>Atta & Flours</option>
                        <option>Rice & Pulses</option>
                        <option>Edible Oils</option>
                        <option>Spices & Salt</option>
                        <option>Tea & Beverages</option>
                        <option>Snacks & Biscuits</option>
                      </select>
                      <input 
                        type="number" placeholder="Price (₹)" value={newProduct.price}
                        onChange={e => setNewProduct({...newProduct, price: e.target.value})}
                        class="p-2 border rounded text-xs" required 
                      />
                      <input 
                        type="text" placeholder="Unit (e.g. 1 kg, 500 g, 1 L)" value={newProduct.unit}
                        onChange={e => setNewProduct({...newProduct, unit: e.target.value})}
                        class="p-2 border rounded text-xs" 
                      />
                      <input 
                        type="text" placeholder="Image URL (Optional)" value={newProduct.image}
                        onChange={e => setNewProduct({...newProduct, image: e.target.value})}
                        class="p-2 border rounded text-xs sm:col-span-2" 
                      />
                      <button type="submit" class="sm:col-span-2 bg-emerald-600 text-white font-bold py-2 rounded text-xs">
                        Save Product
                      </button>
                    </form>
                  </div>

                  {/* Manage Products */}
                  <div class="bg-white p-4 rounded-xl shadow-sm border">
                    <h2 class="font-bold text-slate-800 mb-3">Manage Inventory ({products.length} Items)</h2>
                    <div class="divide-y max-h-96 overflow-y-auto">
                      {products.map(p => (
                        <div key={p.id} class="py-2 flex items-center justify-between text-xs">
                          <div class="flex items-center gap-3">
                            <img src={p.image} class="w-10 h-10 object-cover rounded" />
                            <div>
                              <p class="font-bold text-slate-800">{p.name}</p>
                              <p class="text-slate-500">₹{p.price} / {p.unit}</p>
                            </div>
                          </div>
                          <div class="flex items-center gap-2">
                            <button 
                              onClick={() => toggleStock(p.id)}
                              class={`px-2 py-1 rounded text-[10px] font-bold ${p.inStock ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}
                            >
                              {p.inStock ? 'In Stock' : 'Out of Stock'}
                            </button>
                            <button onClick={() => deleteProduct(p.id)} class="text-red-500 px-2 py-1"><i class="fa-solid fa-trash"></i></button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}
            </main>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
